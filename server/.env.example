# ============================================================
# SERVER ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env for local development
# On Render, set these in the Environment section of your Web Service

PORT=5001

# MongoDB Atlas connection string (replace when ready for production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/green_skills

# JWT secret — use a strong random string in production
JWT_SECRET=green_skills_secret_2026_demo

# Node environment
NODE_ENV=production

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS)
# Example: https://your-app.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
